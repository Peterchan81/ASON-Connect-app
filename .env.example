# ASON Connect Flutter 클라이언트용 공개 환경변수 예시 파일.
#
# 이 파일을 복사해 프로젝트 루트에 `.env`로 저장하고 실제 값을 채워 넣는다.
#   cp .env.example .env
#
# 여기 들어가는 값은 모두 "클라이언트에 노출되어도 되는" 값만 담는다.
# Supabase anon key는 RLS(행 수준 보안)로 보호되는 공개 클라이언트 키다.
#
# ASON Core(C:\ASON\ASON_Core_app)의 .env.example과 동일한 프로젝트를
# 가리켜야 두 앱이 같은 Supabase 테이블(schedules/daily_goals/
# diary_entries/memos)을 공유할 수 있다.
#
# 절대 이 파일(또는 .env)에 서비스 롤 키나 서버 전용 비밀값을 넣지 않는다.

SUPABASE_URL=
SUPABASE_ANON_KEY=
